# Get this from Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" or direct connection string (port 5432), NOT the transaction pooler (6543) for Django migrations.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Razorpay (students pay into this account — see settings.py). Use rzp_test_*
# keys from https://dashboard.razorpay.com -> Settings -> API Keys while
# developing. RAZORPAY_WEBHOOK_SECRET is set separately when you create the
# webhook in the dashboard (Settings -> Webhooks) — it's not the key secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Web Push (order status notifications) — generate a keypair with:
#   python -c "from py_vapid import Vapid02; v=Vapid02(); v.generate_keys(); print(v.private_pem().decode())"
# VAPID_PUBLIC_KEY has a real default baked into settings.py since it's not
# secret (it's what the frontend embeds to subscribe) — only the private
# key needs to be set here.
VAPID_PRIVATE_KEY=your_vapid_private_key_pem
VAPID_CLAIM_EMAIL=mailto:you@example.com

# Resend (order emails + student login OTPs — see settings.py). Get a key
# from https://resend.com -> API Keys. Leave RESEND_API_KEY unset locally
# and OTP requests/order emails will fail loudly instead of silently no-op,
# which is usually what you want in dev. OTP_FROM_EMAIL falls back to
# Resend's own sandbox sender (only delivers to the address you signed up
# with) until a real domain is verified on the Resend dashboard.
RESEND_API_KEY=your_resend_api_key
OTP_FROM_EMAIL=CUFood <noreply@cufood.in>

# Production only (set these in Cloud Run's environment, not locally):
# DJANGO_DEBUG=False
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com
